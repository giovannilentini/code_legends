  "m_ActiveStorage::VariantRecord" -> "m_ActiveStorage::Blob" [arrowhead = "normal", arrowtail = "none", weight = "3"];
  "m_ActiveStorage::Blob" -> "m_ActiveStorage::Attachment" [arrowhead = "none", arrowtail = "none", weight = "1"];
  "m_ActiveStorage::VariantRecord" -> "m_ActiveStorage::Attachment" [arrowhead = "none", arrowtail = "none", weight = "1"];
  "m_ActiveStorage::Blob" -> "m_ActiveStorage::Blob" [style = "dotted", arrowhead = "none", arrowtail = "none", weight = "1", constraint = "false"];
  "m_ActiveStorage::Blob" -> "m_ActiveStorage::Attachment" [arrowhead = "normal", arrowtail = "none", weight = "2"];
  m_User -> m_MatchmakingQueue [arrowhead = "normal", arrowtail = "none", weight = "1"];
  m_User -> m_Match [arrowhead = "normal", arrowtail = "none", weight = "2"];
  m_Challenge -> m_Match [arrowhead = "normal", arrowtail = "none", weight = "1"];
  m_Match -> m_ChatMessage [arrowhead = "normal", arrowtail = "none", weight = "2"];
  m_User -> m_ChatMessage [arrowhead = "normal", arrowtail = "none", weight = "1"];
  m_User -> m_ChallengeRequest [arrowhead = "normal", arrowtail = "none", weight = "2"];
  m_User -> m_ChallengeProposal [arrowhead = "normal", arrowtail = "none", weight = "1"];
  m_ChallengeProposal -> m_Challenge [arrowhead = "none", arrowtail = "none", weight = "2"];
}
